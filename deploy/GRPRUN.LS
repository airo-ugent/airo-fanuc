/PROG  GRPRUN
/ATTR
OWNER		= ;
COMMENT		= "GRIPDISP launcher";
PROG_SIZE	= 100;
CREATE		= DATE 26-05-13  TIME 12:55:00;
MODIFIED	= DATE 26-05-13  TIME 12:55:00;
FILE_NAME	= ;
VERSION		= 0;
LINE_COUNT	= 1;
MEMORY_SIZE	= 300;
PROTECT		= READ_WRITE;
TCD:  STACK_SIZE	= 0,
      TASK_PRIORITY	= 50,
      TIME_SLICE	= 0,
      BUSY_LAMP_OFF	= 0,
      ABORT_REQUEST	= 0,
      PAUSE_REQUEST	= 0;
DEFAULT_GROUP	= *,*,*,*,*;
CONTROL_CODE	= 00000000 00000000;
/APPL
/APPL
/MN
   1:  RUN GRIPDISP    ;
/POS
/END
